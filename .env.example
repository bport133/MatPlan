# Copy this file to .env.local and fill in your Supabase project's values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored, so real values never get committed.
#
# Leave both unset to run MatPlan in local-only mode (localStorage, no
# login) — useful for UI development without a Supabase project.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
